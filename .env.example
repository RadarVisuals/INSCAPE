# Public build configuration. VITE_* values are embedded in the browser bundle.
VITE_PROFILE_DOCUMENT_IPFS_GATEWAY_URL=https://your-public-gateway.example/ipfs/
VITE_IPFS_GATEWAY_URL=https://your-primary-asset-gateway.example/ipfs/
VITE_IPFS_GATEWAY_FALLBACK_URLS=https://your-first-fallback.example/ipfs/,https://your-second-fallback.example/ipfs/

# Server-only Netlify Function secret. Never prefix this with VITE_.
PINATA_JWT=replace-with-a-pinata-jwt-that-can-write-files

