        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "textAlign": null,
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": null
              },
              "content": [
                {
                  "type": "text",
                  "text": "Ik zoek de sporen van arbeid in"
                }
              ]
            },
            {
              "type": "paragraph",
              "attrs": {
                "textAlign": null,
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": null
              },
              "content": [
                {
                  "type": "text",
                  "text": "gebouwen waar niemand meer"
                }
              ]
            },
            {
              "type": "paragraph",
              "attrs": {
                "textAlign": null,
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": null
              },
              "content": [
                {
                  "type": "text",
                  "text": "werkt. Licht, roest en lege ruimte"
                }
              ]
            },
