{
  "name": "underneath-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "lint": "node scripts/lintSource.mjs",
    "typecheck": "node typechecks/verify-workbench-contracts.mjs",
    "format:core": "prettier --write src/public/ownerSystemWorkflow/OwnerSystemWorkflowRuntime.jsx src/public/ownerSystemWorkflow/WorkbenchView.jsx",
    "format:check": "prettier --check src/public/ownerSystemWorkflow/OwnerSystemWorkflowRuntime.jsx src/public/ownerSystemWorkflow/WorkbenchView.jsx",
    "dev": "vite",
    "design-system": "vite --host 127.0.0.1 --open /design-system.html",
    "design-system:tokens": "node scripts/designSystemInventory.js",
    "design-system:check": "node scripts/designSystemInventory.js --check",
    "test:design-system": "node --test scripts/designSystemInventory.test.js scripts/buildDesignSystem.test.js design-system/colourModel.test.js design-system/workspaceLayers.test.js",
    "test:browser:design-system": "node --test browser-tests/design-system.browser.mjs browser-tests/design-system-workspace.browser.mjs browser-tests/design-system-library.browser.mjs browser-tests/design-system-colour.browser.mjs browser-tests/design-system-interactions.browser.mjs",
    "build": "vite build",
    "build:check": "node scripts/checkProductionBuild.js",
    "test": "node --test",
    "test:lukso-standards": "node --test scripts/luksoStandards.audit.test.js",
    "test:browser": "node scripts/runBrowserTests.mjs",
    "verify": "node scripts/verifyRelease.mjs",
    "test:browser:production": "node --import ./scripts/browserEnvironment.mjs --test browser-tests/production-startup.browser.mjs",
    "test:browser:workbench-lifecycle": "node --test browser-tests/workbench-lifecycle.browser.mjs",
    "test:browser:image-module": "node --test browser-tests/image-module.browser.mjs",
    "test:browser:routing": "node --test browser-tests/owner-profile-routing.browser.mjs",
    "test:browser:alpha-support": "node --test browser-tests/alpha-support-preview.browser.mjs",
    "test:browser:system-workflow-phase4b": "node --test browser-tests/owner-system-workflow-publication.browser.mjs",
    "test:browser:system-workflow-production": "node --test browser-tests/owner-system-workflow-production.browser.mjs",
    "preview": "vite preview",
    "design-system:build": "node scripts/buildDesignSystem.js",
    "test:browser:catalog": "node scripts/browserSuiteCatalog.mjs"
  },
  "dependencies": {
    "@erc725/erc725.js": "^0.28.2",
    "@lukso/up-modal": "^0.21.11",
    "@lukso/up-provider": "^0.3.7",
    "@netlify/blobs": "11.1.4",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@wagmi/core": "^3.0.0",
    "buffer": "^6.0.3",
    "lucide-react": "^0.370.0",
    "qrcode-generator": "1.5.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "viem": "^2.54.6",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jose": "^6.2.4",
    "playwright-core": "1.61.1",
    "postcss": "8.5.28",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "^6.4.3"
  }
}
