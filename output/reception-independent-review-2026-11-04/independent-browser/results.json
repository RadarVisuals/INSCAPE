                  "textAlign": null,
                  "spaceBefore": null,
                  "spaceAfter": null,
                  "lineHeight": null
                },
                "content": [
                  {
                    "type": "text",
                    "text": "I work with light, creatures and fragments of digital space. Every image keeps its source and enters a new relationship here."
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "textAlign": null,
                  "spaceBefore": null,
                  "spaceAfter": null,
                  "lineHeight": null
                }
              },
              {
                "type": "paragraph",
                "attrs": {
                  "textAlign": null,
                  "spaceBefore": null,
                  "spaceAfter": null,
                  "lineHeight": null
                },
                "content": [
                  {
                    "type": "text",
                    "text": "This reception is an invitation to explore the work, not a catalogue. Colour, texture and words share one composition."
                  }
                ]
              }
            ]
          },
